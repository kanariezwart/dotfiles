# Development tools
# Install with: brew bundle --file=install/Brewfile.dev

# Taps
tap "oven-sh/bun"

# Languages & runtimes (rust, deno, node and the tools in install/cargo.txt:
# make tools – Homebrew would build them from source)
brew "go"
brew "protobuf"
brew "golangci-lint"

brew "rbenv"

# javascript (node: fnm, see make tools)
brew "yarn"
brew "oven-sh/bun/bun"

# php
brew "php"
brew "composer"

# java (openjdk comes with plantuml)
brew "jenv"

# Infrastructure
brew "kubernetes-cli"
brew "kubectx"
brew "mintoolkit"

# Testing & debugging
brew "testssl"
brew "wrk"
brew "plantuml"
brew "goaccess"
brew "sftpgo"

# Other
brew "adr-tools"

# Apps
cask "docker-desktop"
cask "charles"
cask "ngrok"
